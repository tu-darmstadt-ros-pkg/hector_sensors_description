<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">
	<xacro:property name="M_PI" value="3.14159"/>

	<xacro:macro name="livox_mid360_gazebo" params="visualize:=True name:=default use_rgl:=False">
		<gazebo reference="${name}_laser_frame">

			<!-- ===== RGL-Variante (Livox Mid360 Preset) ===== -->
			<xacro:if value="${use_rgl}">
				<sensor name="rgl_lidar_${name}" type="custom">
					<pose relative_to='${name}_laser_frame'>0 0 0 0 0 0</pose>
					<always_on>true</always_on>
					<update_rate>10</update_rate>
					<visualize>${visualize}</visualize>

					<plugin filename="RGLServerPluginInstance" name="rgl::RGLServerPluginInstance">
						<range>
							<min>0.1</min>
							<max>100.0</max>
						</range>
						<update_rate>10</update_rate>

						<!-- Gazebo-Transport Topic (wird via ros_gz_bridge auf PointCloud2 gemappt) -->
						<topic>/$(arg robot_name)/${name}</topic>

						<!-- Frame-Name, der in die Cloud geschrieben wird -->
						<frame>${name}_laser_frame</frame>

						<!-- Livox Scanmuster (setzt RGL_PATTERNS_DIR voraus) -->
						<pattern_preset>Livox Mid360</pattern_preset>
					</plugin>
				</sensor>
			</xacro:if>

			<!-- ===== Fallback: bisheriger gpu_lidar ===== -->
			<xacro:unless value="${use_rgl}">
				<sensor name='gpu_lidar_${name}' type='gpu_lidar'>
					<pose relative_to='${name}_laser_frame'>0 0 0 0 0 0</pose>
					<topic>/$(arg robot_name)/${name}</topic>
					<update_rate>10</update_rate>
					<gz_frame_id>${name}_laser_frame</gz_frame_id>
					<ray>
						<scan>
							<horizontal>
								<samples>100</samples>
								<resolution>1</resolution>
								<min_angle>${0}</min_angle>
								<max_angle>${2*M_PI}</max_angle>
							</horizontal>
							<vertical>
								<samples>360</samples>
								<resolution>1</resolution>
								<min_angle>${-7.22/180*M_PI}</min_angle>
								<max_angle>${55.22/180*M_PI}</max_angle>
							</vertical>
						</scan>
						<range>
							<min>0.08</min>
							<max>10.0</max>
							<resolution>0.01</resolution>
						</range>
					</ray>
					<always_on>1</always_on>
					<visualize>${visualize}</visualize>
				</sensor>
			</xacro:unless>
		</gazebo>
	</xacro:macro>
</robot>
